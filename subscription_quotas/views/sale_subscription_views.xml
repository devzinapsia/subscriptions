<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_quote_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.quote.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_date']" position="after">
                <field name="max_quotas" invisible="not is_subscription"/>
                <field name="next_quota" invisible="not is_subscription or not max_quotas"/>
                <field name="quota_legend"
                       invisible="not is_subscription or not max_quotas"
                       required="is_subscription and max_quotas"
                       placeholder="E.g. Installment %d of %d"/>
            </xpath>
        </field>
    </record>
</odoo>
